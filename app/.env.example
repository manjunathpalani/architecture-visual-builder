# Optional AI keys (stay on the Vite server; not bundled into the browser)
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# OAuth app IDs for one-click Microsoft / Google sign-in (OneDrive, SharePoint, Google Drive)
# Register a SPA / web app and add redirect: http://localhost:5173/oauth/callback
# Users sign in with Microsoft or Google — they do not type these IDs in the UI.
# For Dynamics 365 metadata, add delegated permission: Dynamics CRM user_impersonation
# MS_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# VITE_MS_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
